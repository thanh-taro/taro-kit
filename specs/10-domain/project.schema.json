{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tarokit.schema.json",
  "title": "TaroKit data model",
  "description": "Shapes of authored content (ENT-CatalogEntry, ENT-Tool, ENT-Category, ENT-Profile, ENT-NowNote, ENT-Resume, ENT-Policy) and on-device personal data (ENT-PersonalData). Meaning and invariants: model.md.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "secureUrl": {
      "$comment": "INV-02: tool addresses and profile links use https.",
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "link": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "description": "A name (INV-09): one text for both languages, or a version per language.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "object",
              "description": "Localized text (INV-09): both versions required; limits apply to each.",
              "required": [
                "en-US",
                "vi-VN"
              ],
              "additionalProperties": false,
              "properties": {
                "en-US": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "vi-VN": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          ]
        },
        "url": {
          "$comment": "INV-02: links use https, except email (mailto) links.",
          "type": "string",
          "pattern": "^(https://|mailto:)"
        },
        "kind": {
          "enum": [
            "email",
            "social",
            "website",
            "code",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "entryBase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "summary",
        "added"
      ],
      "properties": {
        "id": {
          "$comment": "INV-01: entry ids are lowercase slugs.",
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "tool"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "summary": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "vi-VN": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "icon": {
          "$ref": "#/$defs/assetPath"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 24
          },
          "maxItems": 12,
          "uniqueItems": true
        },
        "added": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "hidden": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tool": {
      "allOf": [
        {
          "$ref": "#/$defs/entryBase"
        },
        {
          "$comment": "RULE-07: an embedded tool has origin own (INV-03).",
          "if": {
            "properties": {
              "openMode": {
                "const": "embedded"
              }
            },
            "required": [
              "openMode"
            ]
          },
          "then": {
            "properties": {
              "origin": {
                "const": "own"
              }
            }
          }
        },
        {
          "$comment": "RULE-07: an external tool is always linked.",
          "if": {
            "properties": {
              "origin": {
                "const": "external"
              }
            }
          },
          "then": {
            "properties": {
              "openMode": {
                "const": "linked"
              }
            }
          }
        }
      ],
      "required": [
        "category",
        "url",
        "origin"
      ],
      "properties": {
        "kind": {
          "const": "tool"
        },
        "category": {
          "$comment": "INV-07: every tool belongs to one existing category.",
          "$ref": "#/$defs/slug"
        },
        "url": {
          "$ref": "#/$defs/secureUrl"
        },
        "origin": {
          "enum": [
            "own",
            "external"
          ]
        },
        "openMode": {
          "enum": [
            "embedded",
            "linked"
          ]
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "clipboard-read",
              "clipboard-write",
              "downloads",
              "file-pick",
              "popups",
              "fullscreen",
              "camera",
              "microphone"
            ]
          },
          "default": []
        },
        "offline": {
          "type": "boolean",
          "default": false
        },
        "sourceUrl": {
          "$ref": "#/$defs/secureUrl"
        }
      },
      "unevaluatedProperties": false
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "name",
        "order",
        "intro",
        "icon",
        "tint"
      ],
      "properties": {
        "id": {
          "$comment": "INV-07: category ids are lowercase slugs, like entry ids.",
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "maxLength": 24,
              "minLength": 1
            },
            "vi-VN": {
              "type": "string",
              "maxLength": 24,
              "minLength": 1
            }
          }
        },
        "order": {
          "type": "integer"
        },
        "intro": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "vi-VN": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "icon": {
          "$ref": "#/$defs/assetPath"
        },
        "tint": {
          "$comment": "RULE-14: one of the four category tints.",
          "enum": [
            "violet",
            "mango",
            "sky",
            "mint"
          ]
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "name",
        "headline",
        "bio",
        "links"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "headline": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "vi-VN": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            }
          }
        },
        "avatar": {
          "$ref": "#/$defs/assetPath"
        },
        "bio": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "maxLength": 1500,
              "minLength": 1
            },
            "vi-VN": {
              "type": "string",
              "maxLength": 1500,
              "minLength": 1
            }
          }
        },
        "location": {
          "description": "A name (INV-09): one text for both languages, or a version per language.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Localized text (INV-09): both versions required; limits apply to each.",
              "required": [
                "en-US",
                "vi-VN"
              ],
              "additionalProperties": false,
              "properties": {
                "en-US": {
                  "type": "string",
                  "minLength": 1
                },
                "vi-VN": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 10
        },
        "nickname": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "nowNote": {
      "type": "object",
      "required": [
        "body",
        "updated"
      ],
      "properties": {
        "body": {
          "type": "object",
          "description": "Localized text (INV-09): both versions required; limits apply to each.",
          "required": [
            "en-US",
            "vi-VN"
          ],
          "additionalProperties": false,
          "properties": {
            "en-US": {
              "type": "string",
              "maxLength": 1500,
              "minLength": 1
            },
            "vi-VN": {
              "type": "string",
              "maxLength": 1500,
              "minLength": 1
            }
          }
        },
        "updated": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "personalData": {
      "type": "object",
      "required": [
        "schemaVersion",
        "favorites",
        "recents",
        "preferences",
        "daysUsed"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "favorites": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "toolId",
              "pinnedAt"
            ],
            "properties": {
              "toolId": {
                "$ref": "#/$defs/slug"
              },
              "pinnedAt": {
                "$ref": "#/$defs/timestamp"
              }
            },
            "additionalProperties": false
          }
        },
        "recents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "toolId",
              "openedAt"
            ],
            "properties": {
              "toolId": {
                "$ref": "#/$defs/slug"
              },
              "openedAt": {
                "$ref": "#/$defs/timestamp"
              }
            },
            "additionalProperties": false
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "theme": {
              "enum": [
                "system",
                "light",
                "dark"
              ],
              "default": "system"
            },
            "language": {
              "enum": [
                "en-US",
                "vi-VN"
              ],
              "description": "F-019; absent means the language follows the device (RULE-16)."
            }
          },
          "additionalProperties": false
        },
        "daysUsed": {
          "type": "array",
          "maxItems": 60,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/date"
          },
          "description": "RULE-13"
        }
      }
    },
    "backupFile": {
      "type": "object",
      "required": [
        "format",
        "exportedAt",
        "data"
      ],
      "properties": {
        "format": {
          "const": "tarokit-backup"
        },
        "exportedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "data": {
          "$ref": "#/$defs/personalData"
        }
      }
    },
    "assetPath": {
      "type": "string",
      "pattern": "^(?!(?:.*/)?\\.\\.(?:/|$))/?[A-Za-z0-9_./-]+$",
      "description": "Relative path of an asset bundled with the portal, inside content/assets/ (no \"..\" segments); never a remote address (NFR-05)."
    },
    "yearMonth": {
      "$comment": "A month, YYYY-MM (ENT-Resume).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "resume": {
      "type": "object",
      "required": [],
      "properties": {
        "experience": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "role",
              "organization",
              "start",
              "summary"
            ],
            "properties": {
              "role": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              },
              "organization": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "object",
                    "description": "Localized text (INV-09): both versions required; limits apply to each.",
                    "required": [
                      "en-US",
                      "vi-VN"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en-US": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "vi-VN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  }
                ]
              },
              "start": {
                "$ref": "#/$defs/yearMonth"
              },
              "end": {
                "$ref": "#/$defs/yearMonth"
              },
              "summary": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              },
              "highlights": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "description": "Localized text (INV-09): both versions required; limits apply to each.",
                  "required": [
                    "en-US",
                    "vi-VN"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "en-US": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "vi-VN": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "education": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "program",
              "institution",
              "start"
            ],
            "properties": {
              "program": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              },
              "institution": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "object",
                    "description": "Localized text (INV-09): both versions required; limits apply to each.",
                    "required": [
                      "en-US",
                      "vi-VN"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en-US": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "vi-VN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  }
                ]
              },
              "level": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              },
              "start": {
                "$ref": "#/$defs/yearMonth"
              },
              "end": {
                "$ref": "#/$defs/yearMonth"
              },
              "notes": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  {
                    "type": "object",
                    "description": "Localized text (INV-09): both versions required; limits apply to each.",
                    "required": [
                      "en-US",
                      "vi-VN"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en-US": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "vi-VN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  }
                ]
              },
              "group": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "additionalProperties": false
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "name",
              "level"
            ],
            "properties": {
              "name": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              },
              "level": {
                "type": "object",
                "description": "Localized text (INV-09): both versions required; limits apply to each.",
                "required": [
                  "en-US",
                  "vi-VN"
                ],
                "additionalProperties": false,
                "properties": {
                  "en-US": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "vi-VN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "certificates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "issuer",
              "year"
            ],
            "properties": {
              "name": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "object",
                    "description": "Localized text (INV-09): both versions required; limits apply to each.",
                    "required": [
                      "en-US",
                      "vi-VN"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en-US": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "vi-VN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  }
                ]
              },
              "issuer": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  {
                    "type": "object",
                    "description": "Localized text (INV-09): both versions required; limits apply to each.",
                    "required": [
                      "en-US",
                      "vi-VN"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "en-US": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "vi-VN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  }
                ]
              },
              "year": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              }
            },
            "additionalProperties": false
          }
        },
        "awards": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "title",
              "issuer",
              "year"
            ],
            "properties": {
              "title": {
                "description": "A name (INV-09): one text for both languages, or a version per language.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {

---
// SCR-Settings (MOD-Pages). Regions: 1 shell header, 1b page heading, 2 Appearance with the theme
// choice (F-012.R2), 3 Your data, 4 Privacy statement. Region 3 holds days used (F-006.R6), export and import with
// the backup scope note (F-013.R1, R2, R4, R6), then clear recents (F-006.R4) and erase (F-013.R5), each with its
// confirmation (design: SettingsDesktop, SettingsMobile, SettingsDialogs*).
import { t } from '../../modules/copy/index.ts';
import Icon from '../../modules/design-system/Icon.astro';
import BackupControls from '../../modules/pages/settings/BackupControls.tsx';
import ClearRecents from '../../modules/pages/settings/ClearRecents.tsx';
import EraseData from '../../modules/pages/settings/EraseData.tsx';
import { importReasons } from '../../modules/pages/settings/import-text.ts';
import DaysUsed from '../../modules/pages/settings/DaysUsed.tsx';
import ThemeChoice from '../../modules/pages/settings/ThemeChoice.tsx';
import BaseLayout from '../../modules/shell/BaseLayout.astro';
import { metaFor } from '../../modules/meta/index.ts';
import { getRegistry } from '../../modules/content/index.ts';

// F-012.R2: the three choices, in RULE-03 order.
const choice = {
  legend: t('COPY-settings.theme'),
  options: [
    { value: 'system' as const, label: t('COPY-settings.themeSystem') },
    { value: 'light' as const, label: t('COPY-settings.themeLight') },
    { value: 'dark' as const, label: t('COPY-settings.themeDark') },
  ],
};
---

<BaseLayout {...metaFor({ page: 'settings' }, getRegistry())}>
  <div class="settings">
    <h1>{t('COPY-settings.title')}</h1>

    <section class="card appearance" aria-labelledby="s-appearance">
      <h2 id="s-appearance">{t('COPY-settings.appearance')}</h2>
      <ThemeChoice client:load {...choice} />
    </section>

    <section class="card data" aria-labelledby="s-data">
      <h2 id="s-data">{t('COPY-settings.yourData')}</h2>
      {/* The count is filled in on the device (RULE-13); `{count}` stays a placeholder at build. */}
      <DaysUsed client:load template={t('COPY-settings.daysUsed', { count: '{count}' })} />
      <hr />
      <BackupControls
        client:load
        exportLabel={t('COPY-settings.export')}
        importLabel={t('COPY-settings.import')}
        scope={t('COPY-settings.backupScope')}
        invalidTemplate={t('COPY-settings.importInvalid', { reason: '{reason}' })}
        reasons={importReasons()}
        question={t('COPY-settings.importConfirm')}
        confirmLabel={t('COPY-common.confirm')}
        cancelLabel={t('COPY-common.cancel')}
        unsaved={t('COPY-settings.importUnsaved')}
        exportFailed={t('COPY-settings.exportFailed')}
        importFailed={t('COPY-settings.importFailed')}
      />
      <hr />
      <div class="actions">
        <ClearRecents
          client:load
          label={t('COPY-settings.clearRecents')}
          question={t('COPY-settings.clearRecentsConfirm')}
          confirmLabel={t('COPY-common.confirm')}
          cancelLabel={t('COPY-common.cancel')}
          unsaved={t('COPY-settings.clearRecentsUnsaved')}
        />
        <EraseData
          client:load
          label={t('COPY-settings.erase')}
          question={t('COPY-settings.eraseConfirm')}
          confirmLabel={t('COPY-common.confirm')}
          cancelLabel={t('COPY-common.cancel')}
          unsaved={t('COPY-settings.eraseUnsaved')}
        />
      </div>
    </section>

    <section class="privacy" aria-labelledby="s-privacy">
      <span class="privacy-icon" aria-hidden="true">
        <Icon name="shield" />
      </span>
      <div class="privacy-text">
        <h2 id="s-privacy">{t('COPY-settings.privacyTitle')}</h2>
        <p>{t('COPY-settings.privacy')}</p>
        <p>{t('COPY-settings.privacyTools')}</p>
        <p>{t('COPY-settings.privacyHosting')}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .settings {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-6);
    max-inline-size: var(--tk-size-palette-width);
    padding-block-start: var(--tk-space-4);
  }
  h1 {
    font-size: var(--tk-font-size-5xl);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-3);
    padding: var(--tk-space-5);
    background: var(--tk-color-surface);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-lg);
  }
  .card h2 {
    font-size: var(--tk-font-size-lg);
  }

  /* ThemeChoice island: a segmented radiogroup (design: SettingsDesktop / SettingsMobile). */
  .appearance :global(.choice) {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .appearance :global(legend) {
    margin-block-end: var(--tk-space-2);
    padding: 0;
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-md);
  }
  .appearance :global(.options) {
    display: inline-flex;
    align-self: flex-start;
    gap: var(--tk-space-1);
    padding: var(--tk-space-1);
    background: var(--tk-color-bg);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-lg);
  }
  .appearance :global(.options label) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-4);
    border-radius: var(--tk-radius-md);
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-bold);
    cursor: pointer;
  }
  .appearance :global(.options input) {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  /* A transparent outline is invisible normally and drawn in forced colors, where the fill is removed: the chosen
     theme keeps a cue that isn't color alone (NFR-03, QA a11y M2). */
  .appearance :global(.options label:has(input:checked)) {
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    outline: var(--tk-border-width-focus) solid transparent;
    outline-offset: calc(-1 * var(--tk-border-width-focus));
  }
  .appearance :global(.options label:has(input:focus-visible)) {
    outline: var(--tk-border-width-focus) solid var(--tk-color-accent);
    outline-offset: var(--tk-border-width-focus);
  }

  /* Your data (design: SettingsDesktop / SettingsMobile): days used, then the actions. */
  .data {
    gap: var(--tk-space-4);
  }
  .data hr {
    inline-size: 100%;
    margin: 0;
    border: 0;
    border-block-start: var(--tk-border-width-hairline) solid var(--tk-color-line);
  }
  .data :global(.days) {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-2);
  }
  .data :global(.days-line) {
    font-size: var(--tk-font-size-base);
    font-weight: var(--tk-font-weight-semibold);
  }
  .data :global(.days-strip) {
    display: flex;
    gap: var(--tk-space-1);
  }
  .data :global(.days-strip span) {
    inline-size: var(--tk-space-6);
    block-size: var(--tk-space-6);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-surface2);
  }
  .data :global(.days-strip span[data-used]) {
    background: var(--tk-color-accent);
  }
  /* Forced colors remove the fill: used days keep it in the system text color (NFR-03, QA a11y m1). */
  @media (forced-colors: active) {
    .data :global(.days-strip span[data-used]) {
      forced-color-adjust: none;
      background: CanvasText;
      border-color: CanvasText;
    }
  }
  .actions,
  .data :global(.actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tk-space-3);
  }
  .data :global(.action) {
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-4);
    background: transparent;
    color: var(--tk-color-fg);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-md);
    font: inherit;
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-bold);
    cursor: pointer;
  }
  .data :global(.action:disabled) {
    cursor: default;
  }
  /* Export is the primary action; erase can't be undone (design: SettingsDesktop / SettingsMobile). */
  .data :global(.action--primary) {
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    border-color: var(--tk-color-accent);
  }
  .data :global(.action--danger) {
    color: var(--tk-color-danger);
    border-color: var(--tk-color-danger);
  }
  .data :global(.action[aria-busy='true']) {
    display: inline-flex;
    align-items: center;
    gap: var(--tk-space-2);
    cursor: progress;
  }
  /* SCR-Settings loading: progress on the import control while the file is read and checked. */
  .data :global(.spinner) {
    inline-size: var(--tk-space-4);
    block-size: var(--tk-space-4);
    border: var(--tk-border-width-focus) solid var(--tk-color-line);
    border-block-start-color: var(--tk-color-accent);
    border-radius: 50%;
    animation: tk-spin calc(var(--tk-motion-duration-slow) * 3) linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .data :global(.spinner) {
      animation: none;
    }
  }
  @keyframes tk-spin {
    to {
      transform: rotate(1turn);
    }
  }
  .data :global(.backup) {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-4);
  }
  .data :global(.scope) {
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-md);
    line-height: var(--tk-font-line-height-normal);
  }
  .data :global(.clear-recents),
  .data :global(.erase-data) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--tk-space-3);
  }
  /* F-006.R4: a clear that could not be saved (design: the alert style of SettingsDialogs' import error). */
  .data :global(.action-error) {
    display: flex;
    align-items: flex-start;
    gap: var(--tk-space-3);
    padding: var(--tk-space-3) var(--tk-space-4);
    border: var(--tk-border-width-hairline) solid var(--tk-color-danger);
    border-radius: var(--tk-radius-md);
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-font-line-height-normal);
  }
  .data :global(.action-error .mark) {
    color: var(--tk-color-danger);
    font-family: var(--tk-font-family-mono);
    font-weight: var(--tk-font-weight-bold);
  }

  /* ConfirmDialog (design: SettingsDialogsDesktop, a centered card over the scrim). */
  .settings :global(.tk-confirm) {
    inline-size: min(calc(var(--tk-space-16) * 7.5), calc(100% - 2 * var(--tk-size-gutter)));
    padding: var(--tk-space-6);
    background: var(--tk-color-surface);
    color: var(--tk-color-fg);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-xl);
    box-shadow: var(--tk-shadow-glow);
  }
  .settings :global(.tk-confirm[open]) {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-5);
  }
  .settings :global(.tk-confirm::backdrop) {
    background: var(--tk-color-scrim);
  }
  .settings :global(.tk-confirm__title) {
    font-size: var(--tk-font-size-xl);
    line-height: var(--tk-font-line-height-tight);
  }
  .settings :global(.tk-confirm__detail) {
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-sm);
    overflow-wrap: anywhere;
  }
  .settings :global(.tk-confirm__actions) {
    display: flex;
    justify-content: flex-end;
    gap: var(--tk-space-3);
  }
  .settings :global(.tk-confirm__actions button) {
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-4);
    border-radius: var(--tk-radius-md);
    font: inherit;
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-bold);
    cursor: pointer;
  }
  .settings :global(.tk-confirm__cancel) {
    background: transparent;
    color: var(--tk-color-fg);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
  }
  .settings :global(.tk-confirm__confirm) {
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    border: 0;
  }
  .settings :global(.tk-confirm__confirm--danger) {
    background: var(--tk-color-danger);
    color: var(--tk-color-bg);
  }

  .privacy {
    display: flex;
    align-items: flex-start;
    gap: var(--tk-space-3);
    padding: var(--tk-space-5);
    background: var(--tk-color-tint);
    border-radius: var(--tk-radius-lg);
  }
  .privacy-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--tk-space-10);
    block-size: var(--tk-space-10);
    border-radius: var(--tk-radius-md);
    background: var(--tk-color-surface);
    color: var(--tk-color-accent);
  }
  .privacy-text {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-1);
  }
  .privacy h2 {
    font-size: var(--tk-font-size-base);
  }

  @media (max-width: 720px) {
    .settings {
      gap: var(--tk-space-4);
      padding-block-start: 0;
    }
    h1 {
      font-size: var(--tk-font-size-3xl);
    }
    .card,
    .privacy {
      padding: var(--tk-space-4);
    }
    .card h2 {
      font-size: var(--tk-font-size-base);
    }
    /* Your data: full-width actions and a strip that fills the row (SettingsMobile). */
    .actions,
    .data :global(.actions),
    .data :global(.clear-recents),
    .data :global(.erase-data) {
      flex-direction: column;
      align-items: stretch;
    }
    .data :global(.days-strip) {
      display: grid;
      grid-template-columns: repeat(14, minmax(0, 1fr));
    }
    .data :global(.days-strip span) {
      inline-size: auto;
      block-size: auto;
      aspect-ratio: 1;
    }
    /* The confirmation becomes a bottom sheet, Confirm above Cancel (SettingsDialogsMobile). */
    .settings :global(.tk-confirm) {
      inline-size: 100%;
      max-inline-size: none;
      margin: auto 0 0;
      padding: var(--tk-space-6) var(--tk-space-5) var(--tk-space-8);
      border-width: var(--tk-border-width-hairline) 0 0;
      border-radius: var(--tk-radius-xl) var(--tk-radius-xl) 0 0;
    }
    .settings :global(.tk-confirm__actions) {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .appearance :global(.options) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-self: stretch;
    }
  }
</style>

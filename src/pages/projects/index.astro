---
// SCR-Projects (MOD-Pages) at /projects/: visible projects from the registry (MOD-Content, RULE-06), newest
// year first, then by name. Each card's address is /projects/#<id> (F-009.R4).
// Design: design/canvas/ProjectsDesktop.dc.html, ProjectsMobile.dc.html, EmptyPagesDesktop.dc.html.
// Implements: F-009.R1, F-009.R2, F-009.R3, F-009.R4.
import { getRegistry } from '../../modules/content/index.ts';
import { t } from '../../modules/copy/index.ts';
import { projectImagePath } from '../../modules/pages/projects/index.ts';
import ProjectsView from '../../modules/pages/projects/ProjectsView.astro';
import BaseLayout from '../../modules/shell/BaseLayout.astro';

const { projects } = getRegistry();
const images = Object.fromEntries(
  projects.flatMap((p) => {
    const src = projectImagePath(p);
    return src ? [[p.id, src]] : [];
  }),
);
---

<BaseLayout title={t('COPY-meta.projectsTitle')} description={t('COPY-meta.projectsDescription')} path="/projects/">
  <ProjectsView projects={projects} images={images} />
</BaseLayout>

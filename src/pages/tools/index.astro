---
// SCR-Catalog (MOD-Pages) at /tools/: every visible tool grouped by category, as static HTML, with the search
// island over the hashed catalog data file (MOD-Content `catalogDataFile`, ADR-0002).
// Design: design/canvas/CatalogDesktop.dc.html, CatalogMobile.dc.html, CatalogStatesDesktop.dc.html.
// Implements: F-002.R1 to F-002.R6.
import { join } from 'node:path';
import { catalogDataFile, contentDirectory, getRegistry } from '../../modules/content/index.ts';
import { t } from '../../modules/copy/index.ts';
import { svgFromFile } from '../../modules/design-system/icons.ts';
import { catalogView } from '../../modules/pages/catalog/catalog.ts';
import CatalogView from '../../modules/pages/catalog/CatalogView.astro';
import BaseLayout from '../../modules/shell/BaseLayout.astro';

const registry = getRegistry();
const view = catalogView(registry.categories, registry.visibleTools);
const icons = Object.fromEntries(
  view.groups.map(({ category: c }) => [c.id, svgFromFile(join(contentDirectory(), 'assets', c.icon))]),
);
---

<BaseLayout title={t('COPY-meta.toolsTitle')} description={t('COPY-meta.toolsDescription')} path="/tools/">
  <CatalogView view={view} icons={icons} dataUrl={catalogDataFile(registry).path} />
</BaseLayout>

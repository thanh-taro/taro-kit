---
// MOD-DesignSystem: CMP-CategoryTile. Design: design/canvas/CMP-CategoryTile.dc.html.
// Variants: `compact` (default; category navigation on SCR-Category, F-016.R4), a pill with a small tinted icon and
// the name, where `current` marks the page's own category with its tint and aria-current; and `regular` (the home
// row, F-007.R7), a card-like tile with a 40 px tinted icon square, the name and the count under it (the count moves
// to the row's end on narrow screens, design HomeMobile).
// - The whole tile is one link to the category page; its name reads "<name>, <count>" (aria-label, as in the
//   design; the compact pill shows only the name, which starts the label, so label-in-name holds).
// - The tint (RULE-14, styles/category-tint.css) is decorative; the name always shows. Touch target 44 px (NFR-09).
// - Name and count are in both languages (<L>, a localized aria-label; F-019.R4).
import L from '../language/L.astro';
import { localizedAttrs } from '../language/attrs.ts';
import { mapText, pick, type Loc, type Text } from '../language/languages.ts';

interface Props {
  name: Text;
  /** The category page address, `categoryPath(id)` (F-016.R1). */
  href: string;
  /** COPY-category.toolCount or COPY-category.toolCountOne. */
  count: Loc;
  tint: 'violet' | 'mango' | 'sky' | 'mint';
  /** Build-time inline SVG of the category icon (`svgFromFile`), never user or runtime data. */
  iconSvg: string;
  /** The current category (the page's own; compact only). Default false. */
  current?: boolean;
  /** `compact` (category navigation, default) or `regular` (home row). */
  variant?: 'compact' | 'regular';
}
const { name, href, count, tint, iconSvg, current = false, variant = 'compact' } = Astro.props;
const regular = variant === 'regular';
---

<a
  href={href}
  class="tk-cattile"
  data-variant={variant}
  data-tint={tint}
  {...localizedAttrs(
    'aria-label',
    mapText(count, (c, lang) => `${pick(name, lang)}, ${c}`),
  )}
  aria-current={current ? 'page' : undefined}
>
  <span class="icon" aria-hidden="true" set:html={iconSvg} />
  {regular ? (
    <span class="text">
      <span class="name">
        <L text={name} />
      </span>
      <span class="count">
        <L text={count} />
      </span>
    </span>
  ) : (
    <L text={name} />
  )}
</a>

<style>
  .tk-cattile {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--tk-space-2);
    min-block-size: var(--tk-size-touch-target);
    padding-inline: calc(var(--tk-space-1) + var(--tk-space-1) / 2) calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    border-radius: var(--tk-radius-pill);
    background: var(--tk-color-surface);
    box-shadow: inset 0 0 0 var(--tk-border-width-hairline) var(--tk-color-line);
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--tk-motion-duration-fast) var(--tk-motion-easing-standard),
      transform var(--tk-motion-duration-fast) var(--tk-motion-easing-standard);
  }
  .icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: calc(var(--tk-size-tool-icon-sm) + var(--tk-space-1));
    block-size: calc(var(--tk-size-tool-icon-sm) + var(--tk-space-1));
    border-radius: var(--tk-radius-pill);
    background: var(--cat-bg);
    color: var(--cat-fg);
  }
  .icon :global(.tk-icon) {
    inline-size: var(--tk-size-icon-sm);
    block-size: var(--tk-size-icon-sm);
  }
  /* hover lifts 1 px; focus shows the 2 px accent ring (CMP-CategoryTile). */
  .tk-cattile:hover {
    background: var(--tk-color-surface2);
    transform: translateY(calc(-1 * var(--tk-border-width-hairline)));
  }
  .tk-cattile:focus-visible {
    outline: var(--tk-border-width-focus) solid var(--tk-color-accent);
    outline-offset: var(--tk-border-width-focus);
  }
  .tk-cattile[aria-current='page'] {
    background: var(--cat-bg);
    box-shadow: inset 0 0 0 var(--tk-border-width-hairline) var(--cat-fg);
    color: var(--cat-fg);
    font-weight: var(--tk-font-weight-bold);
  }
  .tk-cattile[aria-current='page'] .icon {
    background: var(--tk-color-surface);
  }
  /* regular: the home row (design HomeDesktop, HomeMobile, CMP-CategoryTile). */
  .tk-cattile[data-variant='regular'] {
    display: flex;
    flex: 1 1 auto;
    gap: var(--tk-space-3);
    min-block-size: var(--tk-space-16);
    padding: var(--tk-space-3) calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    border-radius: var(--tk-radius-lg);
    white-space: normal;
  }
  .tk-cattile[data-variant='regular']:hover {
    box-shadow: inset 0 0 0 var(--tk-border-width-hairline) var(--tk-color-line-strong);
  }
  .tk-cattile[data-variant='regular'] .icon {
    inline-size: var(--tk-space-10);
    block-size: var(--tk-space-10);
    border-radius: var(--tk-radius-md);
  }
  .tk-cattile[data-variant='regular'] .icon :global(.tk-icon) {
    inline-size: var(--tk-size-icon-md);
    block-size: var(--tk-size-icon-md);
  }
  .text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-inline-size: 0;
  }
  .name {
    font-size: var(--tk-font-size-base);
    font-weight: var(--tk-font-weight-bold);
  }
  .count {
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-regular);
  }
  @media (max-width: 720px) {
    .tk-cattile[data-variant='regular'] .text {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--tk-space-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-cattile:hover {
      transform: none;
    }
  }
</style>

---
// MOD-DesignSystem: CMP-StateMessage for static pages. A thin wrapper: the markup is StateMessage.tsx, rendered
// here without hydration, so the static states and the island ones (F-002 no results) share one class contract
// (styles/state-message.css). Design: design/canvas/CMP-StateMessage.dc.html and, for the not-found page,
// design/canvas/NotFoundDesktop.dc.html / NotFoundMobile.dc.html.
// - `icon` names the icon from the icon set; each variant has a default, so a page can pick its own.
// - `page`: whole-page empty or blocking states (tool offline, linked note; catalog empty or no results):
//   centered, a larger icon tile and the title as a heading in the display face (default level 2).
// - Extra actions go in the default slot. The other props are documented in StateMessage.tsx.
import type { Text } from '../language/languages.ts';
import { iconSvg } from './icons.ts';
import StateMessageView, { type StateMessageVariant } from './StateMessage.tsx';

interface Props {
  variant: StateMessageVariant;
  title: Text;
  body?: Text;
  /** The next best action (PRN-05). */
  action?: { href: string; label: Text; newTab?: boolean };
  /** Whole-page layout (CMP-StateMessage "page" variant). */
  page?: boolean;
  /** A short mono line under the title. */
  detail?: Text;
  /** An icon-set name; default per variant (not-found: circle-question-mark). */
  icon?: string;
  headingLevel?: 1 | 2 | 3;
  live?: boolean;
}
const { icon, ...props } = Astro.props;
const ICONS: Record<StateMessageVariant, string> = {
  empty: 'circle-dashed',
  'no-results': 'search-x',
  offline: 'wifi-off',
  info: 'external-link',
  'not-found': 'circle-question-mark',
};
const svg = iconSvg(icon ?? ICONS[props.variant]);
---

{Astro.slots.has('default') ? (
  <StateMessageView {...props} iconSvg={svg}>
    <slot />
  </StateMessageView>
) : (
  <StateMessageView {...props} iconSvg={svg} />
)}

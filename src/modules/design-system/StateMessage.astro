---
// MOD-DesignSystem: CMP-StateMessage for static pages. Design: design/canvas/CMP-StateMessage.dc.html and, for
// the not-found page, design/canvas/NotFoundDesktop.dc.html / NotFoundMobile.dc.html.
// Anatomy: icon tile, title, body, optional primary action; extra actions go in the default slot.
// - `headingLevel` makes the title a heading (1 on SCR-NotFound, where it is the page heading).
// - `icon` names the icon from the icon set; each variant has a default, so a page can pick its own.
// - `live` adds role="status" to the title and body only (not the actions), for messages that appear after the
//   page has loaded (polite announcement, CMP-StateMessage accessibility); a page's own content leaves it off.
// - Actions, links or buttons (the slot), get the 44 px touch target (NFR-09).
// - `page`: whole-page empty or blocking states (tool offline, linked note; catalog empty or no results with F-002):
//   centered, a larger icon tile and the title as a heading in the display face (default level 2).
// - `detail`: a short mono line under the title, such as a linked tool's site (design LinkedDesktop).
// - `action.newTab`: opens in a new tab with no opener or referrer (a linked tool's own address, F-003.R4).
import Icon from './Icon.astro';

type Variant = 'empty' | 'no-results' | 'offline' | 'info' | 'not-found';
interface Props {
  variant: Variant;
  title: string;
  body?: string;
  /** The next best action (PRN-05). */
  action?: { href: string; label: string; newTab?: boolean };
  /** Whole-page layout (CMP-StateMessage "page" variant). */
  page?: boolean;
  /** A short mono line under the title. */
  detail?: string;
  /** An icon-set name; default per variant (not-found: circle-question-mark). */
  icon?: string;
  headingLevel?: 1 | 2 | 3;
  live?: boolean;
}
const { variant, title, body, action, icon, headingLevel, live = false, page = false, detail } = Astro.props;
const ICONS: Record<Variant, string> = {
  empty: 'circle-dashed',
  'no-results': 'search-x',
  offline: 'wifi-off',
  info: 'external-link',
  'not-found': 'circle-question-mark',
};
const level = headingLevel ?? (page ? 2 : undefined);
const Title = level ? (`h${level}` as const) : 'p';
---

<div class="tk-state" data-variant={variant} data-page={page ? '' : undefined}>
  <span class="icon" aria-hidden="true">
    <Icon name={icon ?? ICONS[variant]} />
  </span>
  <div class="text">
    <div class="message" role={live ? 'status' : undefined}>
      <Title class="title">{title}</Title>
      {body && <p class="body">{body}</p>}
    </div>
    {detail && <p class="detail">{detail}</p>}
    {(action || Astro.slots.has('default')) && (
      <div class="actions">
        {action && (
          <a
            class="primary"
            href={action.href}
            target={action.newTab ? '_blank' : undefined}
            rel={action.newTab ? 'noopener noreferrer' : undefined}
          >
            {action.label}
          </a>
        )}
        <slot />
      </div>
    )}
  </div>
</div>

<style>
  .tk-state {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    padding: var(--tk-space-5);
    background: var(--tk-color-surface);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-lg);
    text-align: start;
  }
  .icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--tk-space-10);
    block-size: var(--tk-space-10);
    border-radius: var(--tk-radius-md);
    background: var(--tk-color-tint);
    color: var(--tk-color-accent);
  }
  .text,
  .message {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: calc(var(--tk-space-1) + var(--tk-space-1) / 2);
    min-inline-size: 0;
  }
  .title {
    font-size: var(--tk-font-size-base);
    font-weight: var(--tk-font-weight-bold);
    line-height: var(--tk-font-line-height-tight);
  }
  h1.title {
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-xl);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: -0.01em;
  }
  .body {
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-font-line-height-normal);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tk-space-2);
    padding-block-start: calc(var(--tk-space-1) + var(--tk-space-1) / 2);
  }
  /* Slotted links and buttons are outside this component's scope, so the action style is global within .actions. */
  .actions :global(:is(a, button)) {
    display: inline-flex;
    background: transparent;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-4);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-md);
    color: var(--tk-color-fg);
    font-weight: var(--tk-font-weight-bold);
    text-decoration: none;
  }
  .actions .primary {
    background: var(--tk-color-accent);
    border-color: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
  }
  .actions :global(:is(a, button):focus-visible) {
    outline: var(--tk-border-width-focus) solid var(--tk-color-accent);
    outline-offset: var(--tk-border-width-focus);
  }

  .detail {
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-sm);
  }

  /* page: centered, larger icon tile, display heading (design: ToolStates*, LinkedDesktop). */
  .tk-state[data-page] {
    flex-direction: column;
    align-items: center;
    gap: var(--tk-space-4);
    max-inline-size: calc(var(--tk-space-12) * 10);
    padding: 0;
    background: none;
    border: 0;
    text-align: center;
  }
  [data-page] .icon {
    inline-size: var(--tk-space-16);
    block-size: var(--tk-space-16);
    border-radius: var(--tk-radius-xl);
  }
  [data-page] .icon :global(svg) {
    inline-size: var(--tk-space-8);
    block-size: var(--tk-space-8);
  }
  [data-page] .text,
  [data-page] .message {
    align-items: center;
    gap: var(--tk-space-4);
  }
  [data-page] .title {
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-xl);
    font-weight: var(--tk-font-weight-semibold);
    line-height: var(--tk-font-line-height-normal);
    letter-spacing: -0.02em;
  }
  [data-page] .actions {
    justify-content: center;
    padding-block-start: 0;
  }
  [data-page] .actions .primary {
    min-block-size: calc(var(--tk-size-touch-target) + var(--tk-space-1));
    padding-inline: var(--tk-space-5);
    border-radius: var(--tk-radius-lg);
    font-size: var(--tk-font-size-base);
  }

  @media (max-width: 720px) {
    [data-page] .icon {
      inline-size: calc(var(--tk-space-12) + var(--tk-space-2));
      block-size: calc(var(--tk-space-12) + var(--tk-space-2));
    }
    [data-page] .icon :global(svg) {
      inline-size: var(--tk-space-6);
      block-size: var(--tk-space-6);
    }
    [data-page] .title {
      font-size: var(--tk-font-size-lg);
    }
    .tk-state {
      padding: calc(var(--tk-space-4) + var(--tk-space-1) / 2);
    }
    .actions {
      flex-direction: column;
    }
    .actions :global(:is(a, button)) {
      min-block-size: var(--tk-space-12);
    }
  }
</style>

---
// MOD-DesignSystem: CMP-ProjectCard, one project in the showcase (SCR-Projects).
// Design: design/canvas/CMP-ProjectCard.dc.html, ProjectsDesktop.dc.html, ProjectsMobile.dc.html.
// Anatomy: image or name placeholder; name (a heading); year; summary; description; tags; links.
// - The root is the list item, carrying the project id as its `id`, so `/projects/#<id>` finds it, and
//   `tabindex="-1"`, so the page can focus it (F-009.R4); a focused card shows the accent ring.
// - Without an image, the placeholder is the name's monogram (F-009 edge case; style.md), hidden from assistive tech.
// - Every link opens in a new tab with no opener or referrer, described by COPY-tool.opensNewTab (F-009.R2).
//   The first link is primary unless it is a source-code link; the rest are secondary (design ProjectsDesktop).
// Implements: F-009.R2.
import type { Link } from '../../generated/domain.ts';
import { t } from '../copy/index.ts';
import Icon from './Icon.astro';
import { monogram } from './tool-card.ts';

interface Props {
  project: {
    id: string;
    name: string;
    summary: string;
    description: string;
    tags?: string[];
    year: number;
    links: Link[];
  };
  /** The bundled image's address; without it, the name's monogram shows. */
  imageSrc?: string;
  headingLevel?: 2 | 3;
}
const { project, imageSrc, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const newTabId = `${project.id}-newtab`;
const primaryIndex = project.links[0]?.kind === 'code' ? -1 : 0;
---

<li class="tk-projectcard" id={project.id} tabindex="-1" data-testid="project-card">
  <article>
    {imageSrc ? (
      <img
        class="cover"
        src={imageSrc}
        alt={t('COPY-projects.imageAlt', { name: project.name })}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="cover placeholder" aria-hidden="true">
        {monogram(project.name)}
      </div>
    )}
    <div class="body">
      <div class="head">
        <Heading class="name">{project.name}</Heading>
        <span class="year">{project.year}</span>
      </div>
      <p class="summary">{project.summary}</p>
      <p class="description">{project.description}</p>
      {project.tags && project.tags.length > 0 && (
        <div class="tags">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      {project.links.length > 0 && (
        <div class="links">
          {project.links.map((link, i) => (
            <a
              class="link"
              data-kind={i === primaryIndex ? 'primary' : 'secondary'}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-describedby={newTabId}
            >
              {link.label}
              <Icon name="arrow-up-right" size={16} />
            </a>
          ))}
          <span id={newTabId} class="tk-visually-hidden">
            {t('COPY-tool.opensNewTab')}
          </span>
        </div>
      )}
    </div>
  </article>
</li>

<style>
  .tk-projectcard {
    display: flex;
    min-inline-size: 0;
    border-radius: var(--tk-radius-lg);
    scroll-margin-block: var(--tk-space-6);
  }
  .tk-projectcard:focus {
    outline: none;
  }
  article {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-inline-size: 0;
    overflow: hidden;
    background: var(--tk-color-surface);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-lg);
  }
  /* Opened from its own address (F-009.R4): the accent ring (design ProjectsDesktop, second card). */
  .tk-projectcard:focus article {
    box-shadow: 0 0 0 var(--tk-border-width-focus) var(--tk-color-accent);
  }

  .cover {
    display: block;
    inline-size: 100%;
    block-size: calc(var(--tk-space-16) * 2 + var(--tk-space-10));
    object-fit: cover;
    background: var(--tk-color-surface2);
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tk-color-accent);
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-5xl);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: -0.04em;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-2);
    padding: calc(var(--tk-space-4) + var(--tk-space-1) / 2);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--tk-space-2);
  }
  .name {
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-lg);
    font-weight: var(--tk-font-weight-semibold);
    line-height: var(--tk-font-line-height-tight);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .year {
    flex: none;
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
  }
  .summary {
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-font-line-height-normal);
  }
  .description {
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-md);
    line-height: var(--tk-font-line-height-normal);
    white-space: pre-line;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--tk-space-1) + var(--tk-space-1) / 2);
  }
  .tag {
    padding: calc(var(--tk-space-1) / 2) var(--tk-space-2);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-sm);
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-xs);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tk-space-2);
    padding-block-start: var(--tk-space-1);
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--tk-space-1) + var(--tk-space-1) / 2);
    min-block-size: var(--tk-size-touch-target);
    padding-inline: calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-md);
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-bold);
    text-decoration: none;
  }
  .link[data-kind='primary'] {
    background: var(--tk-color-tint);
    border-color: var(--tk-color-tint);
    color: var(--tk-color-accent);
  }
  .link:hover {
    text-decoration: underline;
  }
  .link:focus-visible {
    outline: var(--tk-border-width-focus) solid var(--tk-color-accent);
    outline-offset: var(--tk-border-width-focus);
  }
  .link :global(.tk-icon) {
    inline-size: var(--tk-size-icon-sm);
    block-size: var(--tk-size-icon-sm);
  }

  @media (max-width: 720px) {
    .cover {
      block-size: calc(var(--tk-space-16) * 2);
    }
    .placeholder {
      font-size: var(--tk-font-size-4xl);
    }
    .body {
      padding: var(--tk-space-4);
    }
  }
</style>

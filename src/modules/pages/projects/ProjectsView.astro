---
// MOD-Pages: the SCR-Projects body, rendered by /projects/ from the registry and by tests from fixture content.
// Regions (after the shell header): 2 the title (COPY-projects.title), 3 the CMP-ProjectCard list, each card a
// list item with a heading and its own address `#<id>`; or, with no visible project, the empty CMP-StateMessage.
// Design: design/canvas/ProjectsDesktop.dc.html, ProjectsMobile.dc.html, EmptyPagesDesktop.dc.html.
// Implements: F-009.R1 (order comes from MOD-Content's visibleProjects), F-009.R2, F-009.R3, F-009.R4.
import type { Link } from '../../../generated/domain.ts';
import { t } from '../../copy/index.ts';
import ProjectCard from '../../design-system/ProjectCard.astro';
import StateMessage from '../../design-system/StateMessage.astro';

interface Props {
  /** Visible projects, already in display order. */
  projects: {
    id: string;
    name: string;
    summary: string;
    description: string;
    tags?: string[];
    year: number;
    links: Link[];
  }[];
  /** Image address per project id, for projects that have one. */
  images: Record<string, string>;
}
const { projects, images } = Astro.props;
---

<div class="projects">
  <h1>{t('COPY-projects.title')}</h1>
  {projects.length > 0 ? (
    <ul class="list" data-testid="projects">
      {projects.map((project) => (
        <ProjectCard project={project} imageSrc={images[project.id]} />
      ))}
    </ul>
  ) : (
    <div class="empty">
      <StateMessage variant="empty" title={t('COPY-projects.empty')} />
    </div>
  )}
</div>

<script>
  import { projectAnchor } from './project-anchor.ts';
  projectAnchor();
</script>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tk-space-6) + var(--tk-space-1));
  }
  h1 {
    font-size: var(--tk-font-size-5xl);
    line-height: var(--tk-font-line-height-tight);
    letter-spacing: -0.03em;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tk-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    align-self: flex-start;
    max-inline-size: calc(var(--tk-space-16) * 10);
  }
  .empty :global(.title) {
    font-size: var(--tk-font-size-lg);
    font-weight: var(--tk-font-weight-regular);
    line-height: var(--tk-font-line-height-normal);
    padding-block-start: var(--tk-space-2);
  }

  @media (max-width: 720px) {
    .projects {
      gap: calc(var(--tk-space-4) + var(--tk-space-1) / 2);
    }
    h1 {
      font-size: var(--tk-font-size-3xl);
    }
    .list {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    }
  }
</style>

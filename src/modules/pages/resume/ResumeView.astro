---
// SCR-Resume body (MOD-Pages), rendered inside BaseLayout by src/pages/resume/[...resume].astro. Static, no island.
// Regions: 2 heading (COPY-resume.title) and intro (COPY-resume.intro); 3 experience as a timeline; 4 education,
// entries like experience with level and notes; 5 skills by group, as chips; 6 languages, certificates
// and awards as short lists. Sections with no entries are left out (RULE-15), and the DOM keeps RULE-15 order: on wide
// screens experience and education fill the main column and the other sections the side column.
// Accessibility (SCR-Resume): each section is a headed region; months are <time datetime="YYYY-MM">; the level marks
// shown on a skill chip is hidden from assistive technology, which reads COPY-resume.skillLevel instead. Narrow: one
// column, and the timeline stacks (the period sits under the organization).
// Design: design/canvas/ResumeDesktop.dc.html, ResumeMobile.dc.html.
// Languages (F-019.R4): every text is in both (<L>, <Each>); periods use each language's month names (RULE-15,
// F-019.AC7); mono word lines use the body face while Vietnamese shows (`tk-mono-words`).
// Implements: F-017.R1, F-017.R2, F-017.R3.
import { tBoth } from '../../copy/index.ts';
import Each from '../../language/Each.astro';
import L from '../../language/L.astro';
import type { Lang } from '../../language/languages.ts';
import { sectionTitle, type ResumeViewData } from './resume.ts';

interface Props {
  view: ResumeViewData;
}
const { view } = Astro.props;
const has = (s: ResumeViewData['sections'][number]) => view.sections.includes(s);
const main = has('experience') || has('education');
const side = has('skills') || has('languages') || has('certificates') || has('awards');
const id = (s: string) => `resume-${s}`;
const credits = (['certificates', 'awards'] as const).filter(has);
---

<div class="resume" data-layout={main && side ? 'both' : 'single'}>
  <div class="head">
    <h1>
      <L text={tBoth('COPY-resume.title')} />
    </h1>
    <p class="intro">
      <L text={tBoth('COPY-resume.intro')} />
    </p>
  </div>

  {main && (
    <div class="main">
      {has('experience') && (
        <section aria-labelledby={id('experience')}>
          <h2 id={id('experience')}>
            <L text={sectionTitle('experience')} />
          </h2>
          <ol class="timeline">
            {view.experience.map((e) => (
              <li data-current={e.period.current ? '' : undefined}>
                <h3 class="title">
                  <L text={e.role} />
                </h3>
                <p class="org">
                  <L text={e.organization} />
                </p>
                <p class="period tk-mono-words">
                  <Each>
                    {(lang: Lang) =>
                      e.period.parts[lang].map((p) =>
                        p.datetime ? <time datetime={p.datetime}>{p.text}</time> : p.text,
                      )
                    }
                  </Each>
                </p>
                <Each as="div" class="text">
                  {(lang: Lang) => e.summary[lang].map((p) => <p>{p}</p>)}
                </Each>
                {e.highlights.length > 0 && (
                  <ul class="highlights">
                    {e.highlights.map((h) => (
                      <li>
                        <L text={h} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
      {has('education') && (
        <section aria-labelledby={id('education')}>
          <h2 id={id('education')}>
            <L text={sectionTitle('education')} />
          </h2>
          <ol class="timeline">
            {view.education.map((e) => (
              <li data-current={e.period.current ? '' : undefined}>
                <h3 class="title">
                  <L text={e.program} />
                </h3>
                <p class="org">
                  <span>
                    <L text={e.institution} />
                  </span>
                  {e.level && (
                    <span class="level">
                      <L text={e.level} />
                    </span>
                  )}
                </p>
                <p class="period tk-mono-words">
                  <Each>
                    {(lang: Lang) =>
                      e.period.parts[lang].map((p) =>
                        p.datetime ? <time datetime={p.datetime}>{p.text}</time> : p.text,
                      )
                    }
                  </Each>
                </p>
                {e.notes['en-US'].length > 0 && (
                  <Each as="div" class="text">
                    {(lang: Lang) => e.notes[lang].map((p) => <p>{p}</p>)}
                  </Each>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  )}

  {side && (
    <div class="side">
      {has('skills') && (
        <section aria-labelledby={id('skills')}>
          <h2 id={id('skills')}>
            <L text={sectionTitle('skills')} />
          </h2>
          <div class="skill-groups">
            {view.skills.map((g, i) => (
              <div class="skill-group">
                {g.label && (
                  <h3 class="group-label tk-mono-words" id={id(`skills-${i}`)}>
                    <L text={g.label} />
                  </h3>
                )}
                <ul class="chips" aria-labelledby={g.label ? id(`skills-${i}`) : undefined}>
                  {g.skills.map((s) => (
                    <li class="chip">
                      <L text={s.name} />
                      {s.levelShort && s.levelText && (
                        <>
                          <span class="chip-level" aria-hidden="true">
                            <L text={s.levelShort} />
                          </span>
                          <span class="tk-visually-hidden">
                            , <L text={s.levelText} />
                          </span>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}
      {has('languages') && (
        <section aria-labelledby={id('languages')}>
          <h2 id={id('languages')}>
            <L text={sectionTitle('languages')} />
          </h2>
          <ul class="rows">
            {view.languages.map((l) => (
              <li>
                <span class="name">
                  <L text={l.name} />
                </span>
                <span class="aside tk-mono-words">
                  <L text={l.level} />
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {credits.map((section) => (
        <section aria-labelledby={id(section)}>
          <h2 id={id(section)}>
            <L text={sectionTitle(section)} />
          </h2>
          <ul class="rows">
            {view[section].map((c) => (
              <li>
                <span class="credit">
                  <span class="name">
                    <L text={c.name} />
                  </span>
                  <span class="issuer">
                    <L text={c.issuer} />
                  </span>
                </span>
                <span class="aside year">{c.year}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</div>

<style>
  .resume {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-10);
    padding-block-start: var(--tk-space-4);
  }
  /* Wide: heading across, experience and education in the main column, the short sections beside them. */
  .resume[data-layout='both'] {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-areas:
      'head head'
      'main side';
    align-items: start;
    column-gap: var(--tk-space-12);
    row-gap: var(--tk-space-10);
  }
  .head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-4);
  }
  .main {
    grid-area: main;
  }
  .side {
    grid-area: side;
  }
  .main,
  .side {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-10);
    min-inline-size: 0;
  }
  .resume[data-layout='single'] .main,
  .resume[data-layout='single'] .side {
    max-inline-size: var(--tk-size-palette-width);
  }
  h1 {
    font-size: var(--tk-font-size-5xl);
    line-height: var(--tk-font-line-height-tight);
    letter-spacing: -0.03em;
  }
  .intro {
    max-inline-size: 60ch;
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-lg);
    line-height: var(--tk-font-line-height-normal);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-4);
  }
  h2 {
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-xl);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: -0.01em;
  }
  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Regions 3 and 4: the timeline. The period sits left of the rail; each entry has a dot on it, filled while the
     period runs to the present. */
  .timeline > li {
    --period: calc(var(--tk-space-16) * 2 + var(--tk-space-6));
    --rail: calc(var(--period) + var(--tk-space-6));
    position: relative;
    display: grid;
    grid-template-columns: var(--period) minmax(0, 1fr);
    column-gap: calc(var(--tk-space-6) * 2);
    align-content: start;
    padding-block-end: var(--tk-space-8);
  }
  .timeline > li > * {
    grid-column: 2;
  }
  .timeline > li > .period {
    grid-column: 1;
    grid-row: 1 / span 5;
    align-self: start;
    padding-block-start: calc(var(--tk-space-1) / 2);
    text-align: end;
  }
  .timeline > li::before {
    position: absolute;
    inset-block: var(--tk-space-2) 0;
    inset-inline-start: var(--rail);
    border-inline-start: var(--tk-border-width-hairline) solid var(--tk-color-line);
    content: '';
  }
  .timeline > li:last-child {
    padding-block-end: 0;
  }
  .timeline > li:last-child::before {
    display: none;
  }
  .timeline > li::after {
    position: absolute;
    inset-block-start: calc(var(--tk-space-1) * 1.5);
    inset-inline-start: calc(var(--rail) - var(--tk-space-1) - var(--tk-border-width-hairline) / 2);
    box-sizing: border-box;
    inline-size: calc(var(--tk-space-2) + var(--tk-space-1) / 2);
    block-size: calc(var(--tk-space-2) + var(--tk-space-1) / 2);
    background: var(--tk-color-bg);
    border: var(--tk-border-width-focus) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-pill);
    content: '';
  }
  .timeline > li[data-current]::after {
    background: var(--tk-color-accent);
    border-color: var(--tk-color-accent);
  }
  .title {
    font-family: var(--tk-font-family-body);
    font-size: var(--tk-font-size-lg);
    font-weight: var(--tk-font-weight-bold);
    line-height: var(--tk-font-line-height-tight);
  }
  .org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tk-space-2);
    margin-block-start: var(--tk-space-1);
    color: var(--tk-color-accent);
    font-size: var(--tk-font-size-md);
    font-weight: var(--tk-font-weight-semibold);
  }
  .level {
    padding: calc(var(--tk-space-1) * 3 / 4) var(--tk-space-2);
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-tint2);
    color: var(--tk-color-accent2-fg);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-bold);
  }
  .period {
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-medium);
    line-height: var(--tk-font-line-height-normal);
  }
  .period time {
    white-space: nowrap;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-2);
    margin-block-start: var(--tk-space-3);
    max-inline-size: 64ch;
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-font-line-height-normal);
  }
  .highlights {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-1);
    margin-block-start: var(--tk-space-3);
    max-inline-size: 64ch;
    font-size: var(--tk-font-size-base);
    line-height: var(--tk-font-line-height-normal);
  }
  .highlights li {
    position: relative;
    padding-inline-start: var(--tk-space-4);
  }
  .highlights li::before {
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-start: var(--tk-space-1);
    inline-size: var(--tk-space-1);
    block-size: var(--tk-space-1);
    background: var(--tk-color-muted);
    border-radius: var(--tk-radius-pill);
    content: '';
  }

  /* Region 5: skills by group (RULE-15): each group's label above its chips, which wrap. */
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-4);
  }
  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-2);
  }
  /* The same small label as SCR-Now's month groups. */
  .group-label {
    margin: 0;
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tk-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--tk-space-1);
    max-inline-size: 100%;
    padding: var(--tk-space-1) var(--tk-space-3);
    color: var(--tk-color-fg);
    background: var(--tk-color-surface);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-pill);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-medium);
    overflow-wrap: anywhere;
  }
  .chip-level {
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
  }

  .name {
    min-inline-size: 0;
    color: var(--tk-color-fg);
    font-size: var(--tk-font-size-base);
    font-weight: var(--tk-font-weight-semibold);
    overflow-wrap: anywhere;
  }
  /* Region 6: languages, certificates and awards: name, then level or issuer and year. */
  .rows {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tk-space-1) + var(--tk-space-1) / 2);
  }
  .rows li {
    display: flex;
    align-items: center;
    gap: var(--tk-space-3);
    min-block-size: var(--tk-space-12);
    padding: var(--tk-space-2) calc(var(--tk-space-3) + var(--tk-space-1) / 2);
    background: var(--tk-color-surface);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-md);
  }
  .credit {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: calc(var(--tk-space-1) / 2);
    min-inline-size: 0;
  }
  .issuer {
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-sm);
  }
  .aside {
    flex: none;
    margin-inline-start: auto;
    color: var(--tk-color-muted);
    font-size: var(--tk-font-size-md);
  }
  .year {
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
  }

  @media (max-width: 720px) {
    .resume,
    .resume[data-layout='both'] {
      display: flex;
      gap: calc(var(--tk-space-8) + var(--tk-space-1));
      padding-block-start: 0;
    }
    .main,
    .side {
      gap: calc(var(--tk-space-8) + var(--tk-space-1));
    }
    .head {
      gap: var(--tk-space-3);
    }
    h1 {
      font-size: var(--tk-font-size-3xl);
    }
    .intro {
      font-size: var(--tk-font-size-base);
    }
    section {
      gap: var(--tk-space-3);
    }
    /* The timeline stacks: the rail on the left, the period under the organization. */
    .timeline > li {
      --rail: calc(var(--tk-space-1) + var(--tk-border-width-hairline));
      grid-template-columns: minmax(0, 1fr);
      padding-inline-start: var(--tk-space-6);
      padding-block-end: var(--tk-space-6);
    }
    .timeline > li > *,
    .timeline > li > .period {
      grid-column: 1;
      grid-row: auto;
    }
    .timeline > li > .period {
      margin-block-start: var(--tk-space-1);
      padding-block-start: 0;
      text-align: start;
    }
    .rows li {
      min-block-size: calc(var(--tk-space-12) + var(--tk-space-1));
    }
  }
</style>

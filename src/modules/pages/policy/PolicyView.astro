---
// SCR-Policy body (MOD-Pages), rendered inside BaseLayout by src/pages/privacy.astro and src/pages/terms.astro.
// Static, no island. Regions: 2 the policy's own title (the page's only <h1>) and COPY-policy.updated with the date in
// full in <time datetime>; 3 each section as an <h2> followed by its paragraphs (<p>) and bulleted lists (<ul>), at
// the reading width. Web links open in a new tab (platform-mapping); email links open the mail app.
// Design: design/canvas/PolicyDesktop.dc.html, PolicyMobile.dc.html.
// Languages (F-019.R4, R6): title, headings and bodies in both (<L>, <Each>), the date in each language's
// conventions; while Vietnamese shows, the translation note follows the date (it is only in the vi-VN text, marked
// `data-l`, so CSS hides it with English showing). Design: PolicyDesktop/PolicyMobile (vi).
// Implements: F-018.R1, F-018.R2, F-019.R6.
import Icon from '../../design-system/Icon.astro';
import Each from '../../language/Each.astro';
import L from '../../language/L.astro';
import type { Lang } from '../../language/languages.ts';
import type { PolicyViewData } from './policy.ts';
import PolicyText from './PolicyText.astro';

interface Props {
  view: PolicyViewData;
}
const { view } = Astro.props;
---

<article class="policy">
  <div class="head">
    <h1>
      <L text={view.title} />
    </h1>
    <p class="updated tk-mono-words">
      <Each>
        {(lang: Lang) => (
          <Fragment>
            {view.updatedLabel[lang].before}
            <time datetime={view.updated}>{view.updatedText[lang]}</time>
            {view.updatedLabel[lang].after}
          </Fragment>
        )}
      </Each>
    </p>
    <div class="translation-note" lang="vi-VN" data-l data-testid="policy-translation-note">
      <Icon name="info" size={16} />
      <p>{view.translationNote}</p>
    </div>
  </div>
  {view.sections.map((section) => (
    <section>
      <h2>
        <L text={section.heading} />
      </h2>
      <Each as="div" class="body">
        {(lang: Lang) =>
          section.blocks[lang].map((block) =>
            block.kind === 'paragraph' ? (
              <p>
                <PolicyText parts={block.parts} />
              </p>
            ) : (
              <ul>
                {block.items.map((item) => (
                  <li>
                    <PolicyText parts={item} />
                  </li>
                ))}
              </ul>
            ),
          )
        }
      </Each>
    </section>
  ))}
</article>

<style>
  .policy {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-10);
    max-inline-size: var(--tk-size-palette-width);
    padding-block-start: var(--tk-space-4);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-4);
  }
  h1 {
    font-size: var(--tk-font-size-5xl);
    line-height: var(--tk-font-line-height-tight);
    letter-spacing: -0.03em;
  }
  .updated {
    margin: 0;
    color: var(--tk-color-muted);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-medium);
  }
  section,
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-3);
  }
  /* F-019.R6 (design PolicyDesktop vi): the translation note, a tinted panel with the info icon in the accent. */
  .translation-note {
    display: flex;
    align-items: flex-start;
    gap: var(--tk-space-3);
    padding: var(--tk-space-3) var(--tk-space-4);
    background: var(--tk-color-tint);
    color: var(--tk-color-fg);
    border-radius: var(--tk-radius-lg);
  }
  .translation-note :global(svg) {
    flex: none;
    margin-block-start: 2px;
    color: var(--tk-color-accent);
  }
  .translation-note p {
    margin: 0;
    font-size: var(--tk-font-size-md);
    line-height: var(--tk-font-line-height-normal);
  }
  h2 {
    font-family: var(--tk-font-family-display);
    font-size: var(--tk-font-size-xl);
    font-weight: var(--tk-font-weight-semibold);
    line-height: var(--tk-font-line-height-tight);
    letter-spacing: -0.01em;
  }
  p,
  ul {
    margin: 0;
    font-size: var(--tk-font-size-lg);
    line-height: var(--tk-font-line-height-normal);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-1);
    padding-inline-start: var(--tk-space-5);
  }
  /* PolicyText renders the links, outside this component's scope. */
  .policy :global(a) {
    color: var(--tk-color-accent);
    text-decoration: underline;
    text-underline-offset: var(--tk-border-width-focus);
    overflow-wrap: anywhere;
  }
  @media (max-width: 720px) {
    .policy {
      gap: var(--tk-space-8);
      padding-block-start: 0;
    }
    .head {
      gap: var(--tk-space-3);
    }
    h1 {
      font-size: var(--tk-font-size-3xl);
    }
    section {
      gap: var(--tk-space-3);
    }
    p,
    ul {
      font-size: var(--tk-font-size-base);
    }
  }
</style>

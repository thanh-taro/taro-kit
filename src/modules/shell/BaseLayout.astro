---
// MOD-Shell <BaseLayout>: the page frame used by every route (CMP-AppShell).
// Head: CSP meta (Astro, ADR-0009), the theme script before first paint (MOD-Theme, F-012.R4),
// the link-preview metadata (MOD-Meta <HeadMeta>, F-015), the single font preload (ADR-0003), the catalog data preload. Body: skip link first, banner, main.
// Slot: default (page content). Offline and updates (F-011): the manifest link here, the worker registration in
// the module script below (MOD-Offline), and the status island in AppShell.
// Palette (MOD-Palette, F-004.R1): the pre-rendered <dialog> with its island after the frame, and the inline
// bootstrap last in <body>, after every search control it arms; its hash is registered here, before <head>.
import '../design-system/styles/global.css';
import manropeLatin from '../../generated/fonts/manrope-latin.woff2?url';
import { getRegistry } from '../content/index.ts';
import { t } from '../copy/index.ts';
import HeadMeta from '../meta/HeadMeta.astro';
import { FAVICONS, MANIFEST_PATH } from '../offline/manifest.ts';
import { paletteBootstrap } from '../palette/logic.ts';
import { paletteDataPath } from '../palette/text.ts';
import PaletteDialog from '../palette/PaletteDialog.astro';
import { frameSrcDirective, inlineScriptHash } from '../security-policy/index.ts';
import { themeInlineScript } from '../theme/inline.ts';
import { THEME_COLORS } from '../theme/theme-color.ts';
import AppShell from './AppShell.astro';

interface Props {
  title: string;
  description: string;
  /** Current route path, e.g. "/". */
  path: string;
  /** Kept out of search results (MOD-Meta: the not-found page). Pages pass `{...metaFor(route, registry)}`. */
  noindex?: boolean;
  /** Set only on /t/<id>/ for an embedded tool: the page's frame-src becomes that tool's origin. */
  embeddedToolUrl?: string;
  /** CMP-AppShell variant: `full` (default) or `compact` (the tool view, SCR-ToolView). */
  variant?: 'full' | 'compact';
  /** Where the skip link jumps: the main region (default), or into the tool on the tool view. */
  skipTo?: string;
}
const { title, description, path, noindex, embeddedToolUrl, variant = 'full', skipTo = '#main' } = Astro.props;

// The CSP meta renders with <head>, so inline-script hashes and the page's frame-src go in here (SP-6).
if (!Astro.csp) throw new Error('security.csp must be enabled (ADR-0009)');
Astro.csp.insertScriptHash(inlineScriptHash(themeInlineScript));
Astro.csp.insertScriptHash(inlineScriptHash(paletteBootstrap));
Astro.csp.insertDirective(frameSrcDirective(embeddedToolUrl));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadMeta title={title} description={description} path={path} noindex={noindex} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={manropeLatin} />
    {/* NFR-01 (QA perf): the catalog data file starts downloading with the page, so the palette and catalog search,
    which fetch it when they hydrate, are ready sooner on a first visit. Same origin (CSP connect-src 'self');
    crossorigin="anonymous" matches fetch()'s same-origin credentials, so the fetch reuses this download. */}
    <link rel="preload" as="fetch" type="application/json" crossorigin="anonymous" href={paletteDataPath()} />
    {/* F-011.R1: installable through the browser's own option (MOD-Offline manifest); the window's color per device
    scheme, which the theme script then sets to the theme showing (MOD-Theme theme-color.ts). */}
    <link rel="manifest" href={MANIFEST_PATH} />
    {/* DEP-17 favicon: the app icon (SVG) and its 32 px PNG fallback (MOD-Offline FAVICONS). */}
    {FAVICONS.map((f) => (
      <link rel="icon" href={f.href} type={f.type} sizes={f.sizes} />
    ))}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLORS.light} />
    <meta name="theme-color" content={THEME_COLORS.dark} />
  </head>
  <body>
    {/* First element of <body>: runs before any content paints (F-012.R4), and after Astro's CSP meta in <head>, so its hash governs it. */}
    {/* set:html on a build-time constant only (themeInlineScript, hashed for the CSP). */}
    <script is:inline set:html={themeInlineScript} />
    <a href={skipTo} class="skip">
      {t('COPY-shell.skip')}
    </a>
    <div class="frame" data-variant={variant}>
      <AppShell path={path} variant={variant} resume={!!getRegistry().resume} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <PaletteDialog />
    {/* set:html on a build-time constant only (paletteBootstrap, hashed for the CSP). */}
    <script is:inline set:html={paletteBootstrap} />
    <script>
      // MOD-Theme after first paint: follow the device setting live and apply every change (F-012.R1, R2).
      import { connectCardAvailability } from '../design-system/tool-card-availability.ts';
      import { connectOffline, online } from '../offline/index.ts';
      import { theme } from '../theme/index.ts';
      import { connectVisitRecording } from '../tool-host/visits.ts';
      import { connectDayRecording } from './day-recording.ts';
      theme();
      // F-006.R6 (RULE-13): every page view, and every return to the page, records today's local date once.
      connectDayRecording();
      // F-006.R1: following a link to a linked tool's own address records the visit (cards, the linked note).
      connectVisitRecording();
      // F-011: the offline worker and update checks (MOD-Offline), and the live unavailable state of static cards.
      connectOffline();
      connectCardAvailability(online);
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--tk-space-4);
    inset-block-start: calc(-1 * var(--tk-space-16));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-4);
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    border-radius: var(--tk-radius-md);
    font-weight: var(--tk-font-weight-bold);
    font-size: var(--tk-font-size-md);
    text-decoration: none;
  }
  .skip:focus {
    inset-block-start: var(--tk-space-4);
  }
  .frame {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-10);
    max-inline-size: var(--tk-size-content-max);
    margin-inline: auto;
    padding: var(--tk-space-4) var(--tk-size-gutter) var(--tk-space-12);
  }
  main {
    padding-inline: var(--tk-space-2);
  }
  main:focus {
    outline: none;
  }
  /* Compact (SCR-ToolView): full width, and the tool area fills the window below the headers. */
  .frame[data-variant='compact'] {
    gap: var(--tk-space-3);
    max-inline-size: none;
    min-block-size: 100dvh;
    padding: var(--tk-space-3) var(--tk-space-4) var(--tk-space-4);
  }
  .frame[data-variant='compact'] main {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--tk-space-3);
    padding-inline: 0;
  }
  @media (max-width: 720px) {
    .frame[data-variant='compact'] {
      gap: 0;
      padding: 0;
    }
    .frame[data-variant='compact'] main {
      gap: 0;
    }
  }
</style>

---
// CMP-AppShell header, full variant (MOD-Shell): logo, navigation with the current page marked,
// theme quick toggle and settings link. Search control, offline indicator, update message and the
// narrow-screen menu arrive with F-004, F-011 and the shell build.
import { t, type CopyId } from '../copy/index.ts';
import Icon from '../design-system/Icon.astro';
import { iconSvg } from '../design-system/icons.ts';
import ThemeToggle from './ThemeToggle.tsx';

interface Props {
  /** Current route path, e.g. "/" (marks the current navigation item). */
  path: string;
}
const { path } = Astro.props;

const nav: [href: string, copy: CopyId][] = [
  ['/', 'COPY-nav.home'],
  ['/tools/', 'COPY-nav.tools'],
  ['/projects/', 'COPY-nav.projects'],
  ['/about/', 'COPY-nav.about'],
  ['/now/', 'COPY-nav.now'],
];
const toggle = {
  labels: {
    light: t('COPY-shell.themeToggle', { theme: 'light' }),
    dark: t('COPY-shell.themeToggle', { theme: 'dark' }),
  },
  icons: { light: iconSvg('sun'), dark: iconSvg('moon') },
};
---

<header class="shell">
  <a href="/" class="logo">
    <span class="mark" aria-hidden="true">
      T
    </span>
    <span class="word">{t('COPY-shell.brand')}</span>
  </a>
  <nav class="nav">
    {nav.map(([href, id]) => (
      <a href={href} aria-current={href === path ? 'page' : undefined}>
        {t(id)}
      </a>
    ))}
  </nav>
  <div class="end">
    <ThemeToggle client:idle {...toggle} />
    <a href="/settings/" class="tk-iconbtn" aria-label={t('COPY-nav.settings')}>
      <Icon name="settings" />
    </a>
  </div>
</header>

<style>
  .shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tk-space-2) var(--tk-space-5);
    min-block-size: calc(var(--tk-size-touch-target) + var(--tk-space-3));
    padding-inline: var(--tk-space-4) var(--tk-space-2);
    background: var(--tk-color-chrome);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-lg);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--tk-space-2);
    min-block-size: var(--tk-size-touch-target);
    color: var(--tk-color-fg);
    text-decoration: none;
    font-family: var(--tk-font-family-display);
    font-weight: var(--tk-font-weight-semibold);
    font-size: var(--tk-font-size-md);
    letter-spacing: 0.02em;
  }
  .word {
    text-transform: uppercase;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tk-space-6);
    block-size: var(--tk-space-6);
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-bold);
  }
  .nav {
    display: flex;
    gap: 2px;
    font-size: var(--tk-font-size-md);
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-3);
    border-radius: var(--tk-radius-sm);
    color: var(--tk-color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--tk-color-fg);
  }
  .nav a[aria-current='page'] {
    background: var(--tk-color-surface2);
    color: var(--tk-color-fg);
    font-weight: var(--tk-font-weight-semibold);
  }
  .end {
    display: flex;
    align-items: center;
    gap: var(--tk-space-1);
    margin-inline-start: auto;
  }
  @media (max-width: 720px) {
    .nav {
      order: 3;
      inline-size: 100%;
      overflow-x: auto;
    }
  }
</style>

---
// CMP-AppShell header (MOD-Shell): logo, navigation with the current page marked, theme quick toggle
// (F-012.R3) and settings link. Variants: full, and narrow below 720 px, where the navigation and the
// settings link collapse behind the Menu button (NavMenu island).
// Slots, rendered only when filled (F-011 fills them):
//   "offline": the quiet offline indicator (COPY-shell.offline), shown in the header;
//   "update":  the update-ready message (COPY-shell.updateReady + COPY-shell.refresh), below the header.
// Below the header, the StorageNotice island shows COPY-storage.unavailable when device storage is refused
// (F-005.R5); it renders nothing otherwise.
// Variant `compact` (the tool view, F-003): logo mark, theme toggle and status only, to leave the most space for
// the tool; below 720 px the bar is hidden and the tool header carries back, favorite and open (SCR-ToolView).
// Search control (F-004.R1, MOD-Palette): a button marked `data-tk-palette-open`, armed by the palette bootstrap
// before any island loads, which also shows the platform's shortcut in its key cap (`data-tk-shortcut`). Full:
// COPY-palette.placeholder's text with the shortcut; compact: COPY-shell.search with the shortcut; narrow: an
// icon button named COPY-shell.search (design CMP-AppShell).
import { t, type CopyId } from '../copy/index.ts';
import Icon from '../design-system/Icon.astro';
import { iconSvg } from '../design-system/icons.ts';
import { SHORTCUT_LABELS } from '../palette/logic.ts';
import { searchControlLead } from '../palette/text.ts';
import NavMenu, { type NavItem } from './NavMenu.tsx';
import StorageNotice from './StorageNotice.tsx';
import ThemeToggle from './ThemeToggle.tsx';

interface Props {
  /** Current route path, e.g. "/" (marks the current navigation item). */
  path: string;
  /** `full` (default) or `compact` (tool view). */
  variant?: 'full' | 'compact';
}
const { path, variant = 'full' } = Astro.props;
const compact = variant === 'compact';

const SETTINGS = '/settings/';
const links: [href: string, copy: CopyId][] = [
  ['/', 'COPY-nav.home'],
  ['/tools/', 'COPY-nav.tools'],
  ['/projects/', 'COPY-nav.projects'],
  ['/about/', 'COPY-nav.about'],
  ['/now/', 'COPY-nav.now'],
];
const items: NavItem[] = [
  // A page below a section (SCR-Category under /tools/) marks that section's item (SCR-Category region 1).
  ...links.map(([href, id]) => ({
    href,
    label: t(id),
    current: href === path,
    inSection: href !== '/' && href !== path && path.startsWith(href),
  })),
  { href: SETTINGS, label: t('COPY-nav.settings'), current: path === SETTINGS, narrowOnly: true },
];
const toggle = {
  labels: {
    light: t('COPY-shell.themeToggle', { theme: 'light' }),
    dark: t('COPY-shell.themeToggle', { theme: 'dark' }),
  },
  icons: { light: iconSvg('sun'), dark: iconSvg('moon') },
};
// A forwarded slot counts as present even when empty, so presence is decided by rendered content.
// set:html below re-emits markup Astro already rendered from the page's own slot, never runtime data.
const filled = async (name: string) => (Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : '');
const offline = await filled('offline');
const update = await filled('update');
---

<div class="shell-wrap" data-variant={variant}>
  <header class="shell">
    <a href="/" class="logo">
      <span class="mark" aria-hidden="true">
        T
      </span>
      <span class={compact ? 'tk-visually-hidden' : 'word'}>{t('COPY-shell.brand')}</span>
    </a>
    {!compact && <NavMenu client:load items={items} menuLabel={t('COPY-nav.menu')} menuIcon={iconSvg('menu', 16)} />}
    <button type="button" class="search" data-tk-palette-open>
      <Icon name="search" size={16} />
      <span class="search-text">{compact ? t('COPY-shell.search') : searchControlLead()}</span>
      <kbd data-tk-shortcut>{SHORTCUT_LABELS.other}</kbd>
    </button>
    <div class="end">
      {offline && <div class="offline" set:html={offline} />}
      {!compact && (
        <button type="button" class="tk-iconbtn search-icon" data-tk-palette-open aria-label={t('COPY-shell.search')}>
          <Icon name="search" />
        </button>
      )}
      <ThemeToggle client:idle {...toggle} />
      {!compact && (
        <a
          href={SETTINGS}
          class="tk-iconbtn settings"
          aria-label={t('COPY-nav.settings')}
          aria-current={path === SETTINGS ? 'page' : undefined}
        >
          <Icon name="settings" />
        </a>
      )}
    </div>
  </header>
  {update && <div class="update" set:html={update} />}
  <StorageNotice client:idle message={t('COPY-storage.unavailable')} />
</div>

<style>
  .shell-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--tk-space-3);
  }
  /* StorageNotice island (design: HomeStatesDesktop, storage tweak). */
  .shell-wrap :global(.storage-notice) {
    display: flex;
    align-items: flex-start;
    gap: var(--tk-space-3);
    padding: var(--tk-space-3) var(--tk-space-4);
    background: var(--tk-color-tint2);
    color: var(--tk-color-accent2-fg);
    border-radius: var(--tk-radius-lg);
    font-size: var(--tk-font-size-base);
    font-weight: var(--tk-font-weight-semibold);
    line-height: var(--tk-font-line-height-normal);
  }
  .shell-wrap :global(.storage-notice .mark) {
    font-family: var(--tk-font-family-mono);
    font-weight: var(--tk-font-weight-bold);
  }
  .shell {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--tk-space-2) var(--tk-space-5);
    min-block-size: calc(var(--tk-size-touch-target) + var(--tk-space-3));
    padding-inline: var(--tk-space-4) var(--tk-space-2);
    background: var(--tk-color-chrome);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-radius: var(--tk-radius-lg);
  }
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--tk-space-2);
    min-block-size: var(--tk-size-touch-target);
    color: var(--tk-color-fg);
    text-decoration: none;
    font-family: var(--tk-font-family-display);
    font-weight: var(--tk-font-weight-semibold);
    font-size: var(--tk-font-size-md);
    letter-spacing: 0.02em;
  }
  .word {
    text-transform: uppercase;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tk-space-6);
    block-size: var(--tk-space-6);
    border-radius: var(--tk-radius-sm);
    background: var(--tk-color-accent);
    color: var(--tk-color-on-accent);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-bold);
  }
  .end {
    display: flex;
    align-items: center;
    gap: var(--tk-space-1);
    margin-inline-start: auto;
  }
  /* Search control (design CMP-AppShell): a field-like button with the shortcut's key cap. */
  .search {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    gap: var(--tk-space-2);
    min-inline-size: 0;
    min-block-size: var(--tk-size-touch-target);
    margin-inline-start: auto;
    padding-inline: var(--tk-space-3) var(--tk-space-1);
    background: var(--tk-color-surface);
    color: var(--tk-color-muted);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line-strong);
    border-radius: var(--tk-radius-md);
    font-size: var(--tk-font-size-sm);
    font-weight: var(--tk-font-weight-medium);
    cursor: pointer;
  }
  .search:hover {
    color: var(--tk-color-fg);
  }
  .search-text {
    min-inline-size: calc(var(--tk-space-16) * 2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search kbd {
    flex: none;
    margin-inline-start: auto;
    padding: 1px var(--tk-space-1);
    background: var(--tk-color-surface2);
    color: var(--tk-color-fg);
    border: var(--tk-border-width-hairline) solid var(--tk-color-line);
    border-block-end-width: var(--tk-border-width-focus);
    border-radius: var(--tk-radius-sm);
    font-family: var(--tk-font-family-mono);
    font-size: var(--tk-font-size-xs);
    font-weight: var(--tk-font-weight-medium);
  }
  .search ~ .end {
    margin-inline-start: 0;
  }
  .search-icon {
    display: none;
    color: var(--tk-color-fg);
  }
  .shell-wrap[data-variant='compact'] .search {
    inline-size: calc(var(--tk-space-16) * 3 + var(--tk-space-6) + var(--tk-space-1));
    flex: none;
    margin-inline-start: 0;
    gap: var(--tk-space-2);
  }
  .shell-wrap[data-variant='compact'] .search ~ .end {
    margin-inline-start: auto;
  }

  /* Between the narrow layout and room for the full control, the full shell uses the icon control. */
  @media (max-width: 880px) {
    .shell-wrap[data-variant='full'] .search {
      display: none;
    }
    .shell-wrap[data-variant='full'] .search-icon {
      display: inline-flex;
    }
    .shell-wrap[data-variant='full'] .end {
      margin-inline-start: auto;
    }
  }

  .settings[aria-current='page'] {
    background: var(--tk-color-surface2);
    color: var(--tk-color-fg);
  }

  /* NavMenu island markup (not scoped: islands render outside Astro's scoping). */
  .shell :global(.nav .menu) {
    display: none;
  }
  .shell :global(.nav .list) {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--tk-font-size-md);
  }
  .shell :global(.nav .list a) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tk-size-touch-target);
    padding-inline: var(--tk-space-3);
    border-radius: var(--tk-radius-sm);
    color: var(--tk-color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .shell :global(.nav .list a:hover) {
    color: var(--tk-color-fg);
  }
  .shell :global(.nav .list a[aria-current]) {
    background: var(--tk-color-surface2);
    color: var(--tk-color-fg);
    font-weight: var(--tk-font-weight-semibold);
  }
  .shell :global(.nav .narrow-only) {
    display: none;
  }

  .shell-wrap[data-variant='compact'] .shell {
    min-block-size: calc(var(--tk-size-touch-target) + var(--tk-space-2));
    padding-inline: var(--tk-space-3) var(--tk-space-1);
    border-radius: var(--tk-radius-md);
  }

  /* Narrow variant (CMP-AppShell): logo, theme toggle, Menu; the links open in a panel below. */
  @media (max-width: 720px) {
    .shell {
      gap: var(--tk-space-1);
      padding-inline: var(--tk-space-4) var(--tk-space-1);
    }
    .logo {
      font-size: var(--tk-font-size-sm);
    }
    .shell :global(.nav) {
      order: 3;
    }
    .settings,
    .search {
      display: none;
    }
    .search-icon {
      display: inline-flex;
    }
    .search ~ .end {
      margin-inline-start: auto;
    }
    .shell :global(.nav .menu) {
      display: inline-flex;
      align-items: center;
      gap: var(--tk-space-2);
      min-block-size: var(--tk-size-touch-target);
      padding-inline: var(--tk-space-3);
      background: var(--tk-color-surface2);
      border: var(--tk-border-width-hairline) solid var(--tk-color-line);
      border-radius: var(--tk-radius-md);
      color: var(--tk-color-fg);
      font-size: var(--tk-font-size-sm);
      font-weight: var(--tk-font-weight-semibold);
      cursor: pointer;
    }
    .shell :global(.nav .list) {
      display: none;
    }
    .shell :global(.nav[data-open] .list) {
      position: absolute;
      inset-inline: 0;
      inset-block-start: calc(100% + var(--tk-space-2));
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: var(--tk-space-2);
      background: var(--tk-color-surface);
      border: var(--tk-border-width-hairline) solid var(--tk-color-line);
      border-radius: var(--tk-radius-lg);
      box-shadow: var(--tk-shadow-glow);
      font-size: var(--tk-font-size-base);
    }
    .shell :global(.nav[data-open] .list a) {
      display: flex;
    }
    .shell :global(.nav .narrow-only) {
      display: list-item;
    }
    /* SCR-ToolView narrow: the shell bar is hidden; the tool header takes its place. */
    .shell-wrap[data-variant='compact'] .shell {
      display: none;
    }
    .shell-wrap[data-variant='compact'] {
      gap: 0;
    }
  }
</style>

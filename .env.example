# TaroKit environment variables. Copy to .env only if you need one of them locally; .env is gitignored.
# Nothing here is read automatically: the build reads the shell environment. Never put a secret VALUE in this file
# or in any committed file. Full detail: docs/deploy/environments.md.

# --- Build-time, release-relevant -----------------------------------------------------------------------------
# Origin the portal serves from (canonical URLs, og:url, sitemap, robots). Empty means https://tarokit.app.
# `pnpm build` clears it on purpose; `pnpm build:staging` sets it to https://staging.tarokit.app.
# Leave blank for every release build; do not set it by hand.
TAROKIT_PORTAL_ORIGIN=

# Content folder to read instead of ./content. Empty means ./content. Tests and the sample build only.
# Never set in a release build (pnpm build clears it; check-dist-clean fails if content leaks).
TAROKIT_CONTENT_DIR=

# --- Test-only: never set in a release build -------------------------------------------------------------------
# 1 builds the tests-only pages into dist-fixtures/ (pnpm build:fixtures sets it).
TAROKIT_FIXTURES=
# 1 builds the e2e sample site into dist-samples/ (pnpm build:samples sets it).
TAROKIT_SAMPLES=
# Playwright ports. Default 4321 and 4322; change when another worktree holds them.
TK_E2E_PORT=
TK_E2E_FIXTURES_PORT=

# --- Tooling ---------------------------------------------------------------------------------------------------
# Python used by pnpm gen for font subsetting. Empty means ./.venv, else python3.
PYTHON=
# Set to https://staging.tarokit.app or similar only to run scripts/smoke-test.sh against a local copy (tests only).
SMOKE_BASE=
# Keep Astro and wrangler telemetry off.
ASTRO_TELEMETRY_DISABLED=1
WRANGLER_SEND_METRICS=false

# --- Secrets: NAMES ONLY, leave blank here ----------------------------------------------------------------------
# Live in the GitHub environments `staging` and `production` (gh secret set ... --env ...) and are read only by the
# publish.yml Deploy step. For a local deploy use `npx wrangler login` instead and leave these unset.
# Scope: Account / Workers Scripts / Edit on the one account, nothing else.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

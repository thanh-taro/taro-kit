---
// Tests-only page (built with TAROKIT_FIXTURES=1 into dist-fixtures/, never into dist/; astro.config.ts).
// SCR-Catalog's empty state (F-002.AC8), which the fixture build's own content cannot show: the catalog body from
// tests/fixtures/content/F010_AC6-no-note-no-tools, which has categories but no tools.
import { join } from 'node:path';
import { loadRegistry } from '../../../src/modules/content/index.ts';
import { t } from '../../../src/modules/copy/index.ts';
import { catalogView } from '../../../src/modules/pages/catalog/catalog.ts';
import CatalogView from '../../../src/modules/pages/catalog/CatalogView.astro';
import BaseLayout from '../../../src/modules/shell/BaseLayout.astro';

const registry = loadRegistry({ contentDir: join(process.cwd(), 'tests/fixtures/content/F010_AC6-no-note-no-tools') });
const view = catalogView(registry.categories, registry.visibleTools);
---

<BaseLayout title={t('COPY-meta.toolsTitle')} description={t('COPY-meta.toolsDescription')} path="/tools/">
  <CatalogView view={view} icons={{}} dataUrl="" />
</BaseLayout>

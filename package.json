{
  "name": "tarokit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run gen && astro dev",
    "gen": "node scripts/gen.ts",
    "gen:check": "node scripts/gen.ts --check",
    "content:validate": "node scripts/content-validate.ts",
    "build": "pnpm run gen && TAROKIT_CONTENT_DIR= TAROKIT_PORTAL_ORIGIN= pnpm run content:validate && TAROKIT_FIXTURES= TAROKIT_CONTENT_DIR= TAROKIT_PORTAL_ORIGIN= astro build && node scripts/check-dist-fonts.ts && node scripts/check-dist-clean.ts",
    "build:fixtures": "pnpm run gen && TAROKIT_FIXTURES=1 TAROKIT_CONTENT_DIR=tests/fixtures/content/F005-favorites astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "astro check && pnpm run gen:check",
    "licenses:check": "node scripts/check-licenses.ts",
    "fonts:check": "node scripts/check-dist-fonts.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "~7.3.8",
    "lucide-static": "^1.55.0",
    "preact": "~10.29.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "style-dictionary": "^5.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
